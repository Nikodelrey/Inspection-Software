// ═══════════════════════════════════════
// STATE
// ═══════════════════════════════════════
var rooms = {};
var currentCatId = null;
var currentRoomIdx = 0;
var currentItemId = null;
var cameFromPicker = false;

function makeRoomState(cat) {
  var extraData = {};
  if (cat.extraFields) {
    cat.extraFields.forEach(function(f) { extraData[f.key] = ""; });
  }
  var itemStates = {};
  cat.items.forEach(function(item) {
    itemStates[item.id] = {
      meetsReq: false,
      conditions: item.conditions.map(function() { return { checked: false, comment: "" }; })
    };
  });
  return { label: "", na: false, extraData: extraData, itemStates: itemStates };
}

categories.forEach(function(cat) {
  rooms[cat.id] = [makeRoomState(cat)];
});

// ═══════════════════════════════════════
// SCREEN NAVIGATION
// ═══════════════════════════════════════
function showScreen(id) {
  var screens = ["screen-form","screen-main","screen-roompicker","screen-category","screen-item"];
  screens.forEach(function(s) {
    document.getElementById(s).style.display = "none";
  });
  document.getElementById(id).style.display = "block";
  window.scrollTo(0, 0);
}

function showMain() {
  cameFromPicker = false;
  renderMain();
  showScreen("screen-main");
}

function goBackFromCategory() {
  if (cameFromPicker) {
    showRoomPicker(currentCatId);
  } else {
    showMain();
  }
}

function showCategory() {
  var cat = categories.find(function(c) { return c.id === currentCatId; });
  var room = rooms[currentCatId][currentRoomIdx];
  renderCategoryItems(cat, room);
  showScreen("screen-category");
}

// ═══════════════════════════════════════
// SCREEN 1 - MAIN MENU
// ═══════════════════════════════════════
function renderMain() {
  var tbody = document.getElementById("mainTableBody");
  tbody.innerHTML = "";
  categories.forEach(function(cat) {
    var roomList = rooms[cat.id];
    var rrCount = 0;
    roomList.forEach(function(room) {
      if (room.na) return;
      cat.items.forEach(function(item) {
        var s = room.itemStates[item.id];
        if (!s.meetsReq) {
          var hasRR = s.conditions.some(function(c, i) {
            return c.checked && ["B","RRE","RRP","SC","LIC"].indexOf(item.conditions[i].code) >= 0;
          });
          if (hasRR) rrCount++;
        }
      });
    });

    var tr = document.createElement("tr");

    var td1 = document.createElement("td");
    var nameBtn = document.createElement("button");
    nameBtn.className = "main-link";
    nameBtn.innerHTML = cat.name;
    if (rrCount > 0) {
      nameBtn.innerHTML += ' <span class="room-badge">' + rrCount + "</span>";
    }
    if (roomList.length > 1) {
      nameBtn.innerHTML += ' <span class="room-badge" style="background:#1a2744;">' + roomList.length + "</span>";
    }
    nameBtn.addEventListener("click", (function(id) {
      return function() { handleCategoryClick(id); };
    })(cat.id));
    td1.appendChild(nameBtn);

    var td2 = document.createElement("td");
    td2.className = "add-room-cell";
    var addBtn = document.createElement("button");
    addBtn.className = "btn-add";
    addBtn.textContent = "Add";
    addBtn.addEventListener("click", (function(id) {
      return function(e) { e.stopPropagation(); addNewRoom(id); };
    })(cat.id));
    td2.appendChild(addBtn);

    tr.appendChild(td1);
    tr.appendChild(td2);
    tbody.appendChild(tr);
  });
}

function handleCategoryClick(catId) {
  if (rooms[catId].length === 1) {
    cameFromPicker = false;
    openCategory(catId, 0);
  } else {
    showRoomPicker(catId);
  }
}

function addNewRoom(catId) {
  var cat = categories.find(function(c) { return c.id === catId; });
  rooms[catId].push(makeRoomState(cat));
  cameFromPicker = false;
  openCategory(catId, rooms[catId].length - 1);
}

// ═══════════════════════════════════════
// SCREEN 1B - ROOM PICKER
// ═══════════════════════════════════════
function showRoomPicker(catId) {
  currentCatId = catId;
  var cat = categories.find(function(c) { return c.id === catId; });
  document.getElementById("rpTitle").textContent = cat.name;

  var list = document.getElementById("roomPickerList");
  list.innerHTML = "";

  rooms[catId].forEach(function(room, ri) {
    var rrCount = 0;
    cat.items.forEach(function(item) {
      var s = room.itemStates[item.id];
      if (s && s.conditions.some(function(c, i) {
        return c.checked && ["B","RRE","RRP","SC","LIC"].indexOf(item.conditions[i].code) >= 0;
      })) rrCount++;
    });

    var label = room.label ? ('"' + room.label + '"') : ("Room " + (ri + 1));

    var row = document.createElement("div");
    row.style.cssText = "display:flex;align-items:center;justify-content:space-between;padding:10px 0;border-bottom:1px solid #ddd;";

    var openBtn = document.createElement("button");
    openBtn.className = "main-link";
    openBtn.innerHTML = label + (rrCount > 0 ? ' <span class="room-badge">' + rrCount + " RR</span>" : "");
    openBtn.addEventListener("click", (function(id, idx) {
      return function() { cameFromPicker = true; openCategory(id, idx); };
    })(catId, ri));

    var delBtn = document.createElement("button");
    delBtn.textContent = "Delete";
    delBtn.style.cssText = "background:none;border:1px solid #cc3300;color:#cc3300;border-radius:4px;padding:5px 12px;font-size:12px;cursor:pointer;";
    delBtn.addEventListener("click", (function(id, idx) {
      return function() { deleteRoom(id, idx); };
    })(catId, ri));

    row.appendChild(openBtn);
    row.appendChild(delBtn);
    list.appendChild(row);
  });

  var addRow = document.createElement("div");
  addRow.style.cssText = "padding:12px 0;";
  var addBtn = document.createElement("button");
  addBtn.className = "btn-add";
  addBtn.textContent = "+ Add Another Room";
  addBtn.style.width = "100%";
  addBtn.style.padding = "10px";
  addBtn.addEventListener("click", function() {
    var cat2 = categories.find(function(c) { return c.id === catId; });
    rooms[catId].push(makeRoomState(cat2));
    cameFromPicker = true;
    openCategory(catId, rooms[catId].length - 1);
  });
  addRow.appendChild(addBtn);
  list.appendChild(addRow);

  showScreen("screen-roompicker");
}

function deleteRoom(catId, roomIdx) {
  if (rooms[catId].length <= 1) {
    alert("Cannot delete the only room.");
    return;
  }
  if (!confirm("Delete this room and all its data?")) return;
  rooms[catId].splice(roomIdx, 1);
  showRoomPicker(catId);
}

// ═══════════════════════════════════════
// SCREEN 2 - CATEGORY
// ═══════════════════════════════════════
function openCategory(catId, roomIdx) {
  currentCatId = catId;
  currentRoomIdx = roomIdx;
  var cat = categories.find(function(c) { return c.id === catId; });
  var room = rooms[catId][roomIdx];
  var roomLabel = rooms[catId].length > 1 ? (" (Room " + (roomIdx + 1) + ")") : "";

  document.getElementById("catScreenTitle").textContent = cat.name + roomLabel;
  document.getElementById("catNACheck").checked = room.na;
  document.getElementById("catLabelInput").value = room.label || "";

  renderExtraFields(cat, room);
  renderCategoryItems(cat, room);
  showScreen("screen-category");
}

function renderExtraFields(cat, room) {
  var container = document.getElementById("catExtraFields");
  container.innerHTML = "";
  if (!cat.extraFields || cat.extraFields.length === 0) return;

  var sectionTitle = cat.id === 'electric' ? 'Service at Panel' : (cat.id === 'water-heater' ? 'Water heater information*' : '');
  if (sectionTitle) {
    var lbl = document.createElement("div");
    lbl.textContent = sectionTitle;
    lbl.style.cssText = "font-size:13px;font-weight:bold;color:#222;margin-bottom:6px;";
    container.appendChild(lbl);
  }

  cat.extraFields.forEach(function(field) {
    var wrap = document.createElement("span");
    wrap.style.cssText = "display:inline-flex;align-items:center;gap:5px;margin-right:12px;";

    var lbl2 = document.createElement("strong");
    lbl2.textContent = field.label;
    wrap.appendChild(lbl2);

    if (field.type === "text") {
      var inp = document.createElement("input");
      inp.type = "text";
      inp.id = "extra-" + field.key;
      inp.value = room.extraData[field.key] || "";
      inp.style.cssText = "border:1px solid #bbb;border-radius:3px;padding:4px 8px;font-size:13px;width:80px;font-family:inherit;outline:none;";
      wrap.appendChild(inp);
    } else if (field.type === "select") {
      var sel = document.createElement("select");
      sel.id = "extra-" + field.key;
      sel.style.cssText = "border:1px solid #bbb;border-radius:3px;padding:4px 8px;font-size:13px;font-family:inherit;outline:none;background:white;";
      field.options.forEach(function(opt) {
        var o = document.createElement("option");
        o.value = (opt === field.options[0]) ? "" : opt;
        o.textContent = opt;
        if ((room.extraData[field.key] || "") === o.value) o.selected = true;
        sel.appendChild(o);
      });
      wrap.appendChild(sel);
    }
    container.appendChild(wrap);
  });
}

function renderCategoryItems(cat, room) {
  var tbody = document.getElementById("catItemsBody");
  tbody.innerHTML = "";

  // Select All row
  var selRow = document.createElement("tr");
  selRow.className = "select-all-row";
  var selTd = document.createElement("td");
  selTd.colSpan = 2;
  var selLabel = document.createElement("label");
  selLabel.style.cssText = "display:flex;align-items:center;gap:8px;font-weight:bold;font-size:14px;cursor:pointer;";
  var selCheck = document.createElement("input");
  selCheck.type = "checkbox";
  selCheck.id = "selectAllCheck";
  selCheck.style.cssText = "width:18px;height:18px;cursor:pointer;";
  selCheck.addEventListener("change", function() { selectAll(this); });
  selLabel.appendChild(selCheck);
  selLabel.appendChild(document.createTextNode("Select All"));
  selTd.appendChild(selLabel);
  var selTd2 = document.createElement("td");
  selRow.appendChild(selTd);
  selRow.appendChild(selTd2);
  tbody.appendChild(selRow);

  cat.items.forEach(function(item, idx) {
    var s = room.itemStates[item.id];
    var hasRR = s.conditions.some(function(c, i) {
      return c.checked && ["B","RRE","RRP","SC","LIC"].indexOf(item.conditions[i].code) >= 0;
    });
    var hasFindings = s.conditions.some(function(c) { return c.checked; });

    var tr = document.createElement("tr");
    tr.className = "item-row";

    // Checkbox cell
    var td1 = document.createElement("td");
    td1.className = "item-check-cell";
    var chk = document.createElement("input");
    chk.type = "checkbox";
    chk.checked = s.meetsReq;
    chk.style.cssText = "width:18px;height:18px;cursor:pointer;";
    chk.addEventListener("change", (function(id) {
      return function() { toggleMeetsReq(id, this); };
    })(item.id));
    td1.appendChild(chk);

    // Name cell
    var td2 = document.createElement("td");
    var nameBtn = document.createElement("button");
    nameBtn.className = "item-name-btn";
    nameBtn.innerHTML = ((cat.itemStartIndex || 1) + idx) + ". " + item.name;
    if (hasRR) nameBtn.innerHTML += ' <span class="item-rr-indicator"></span>';
    nameBtn.addEventListener("click", (function(id) {
      return function() { openItem(id); };
    })(item.id));
    td2.appendChild(nameBtn);

    if (hasRR) {
      var note = document.createElement("div");
      note.className = "item-inline-comment";
      note.textContent = "Required repair flagged";
      td2.appendChild(note);
    } else if (hasFindings) {
      var note2 = document.createElement("div");
      note2.className = "item-inline-comment";
      note2.textContent = "Has comments";
      td2.appendChild(note2);
    }

    // Comment button cell
    var td3 = document.createElement("td");
    td3.className = "item-comment-cell";
    var addBtn = document.createElement("button");
    addBtn.className = "btn-comment-add";
    addBtn.textContent = "Add";
    addBtn.addEventListener("click", (function(id) {
      return function() { openItem(id); };
    })(item.id));
    td3.appendChild(addBtn);

    tr.appendChild(td1);
    tr.appendChild(td2);
    tr.appendChild(td3);
    tbody.appendChild(tr);
  });
}

function toggleMeetsReq(itemId, cb) {
  rooms[currentCatId][currentRoomIdx].itemStates[itemId].meetsReq = cb.checked;
  updateSelectAll();
}

function selectAll(cb) {
  var room = rooms[currentCatId][currentRoomIdx];
  var cat = categories.find(function(c) { return c.id === currentCatId; });
  cat.items.forEach(function(item) {
    room.itemStates[item.id].meetsReq = cb.checked;
  });
  openCategory(currentCatId, currentRoomIdx);
}

function updateSelectAll() {
  var room = rooms[currentCatId][currentRoomIdx];
  var cat = categories.find(function(c) { return c.id === currentCatId; });
  var all = cat.items.every(function(item) { return room.itemStates[item.id].meetsReq; });
  var el = document.getElementById("selectAllCheck");
  if (el) el.checked = all;
}

function toggleCatNA(cb) {
  rooms[currentCatId][currentRoomIdx].na = cb.checked;
}

function saveExtraFields() {
  var cat = categories.find(function(c) { return c.id === currentCatId; });
  if (!cat.extraFields) return;
  cat.extraFields.forEach(function(field) {
    var el = document.getElementById("extra-" + field.key);
    if (el) rooms[currentCatId][currentRoomIdx].extraData[field.key] = el.value;
  });
}

function saveCategory() {
  rooms[currentCatId][currentRoomIdx].label = document.getElementById("catLabelInput").value;
  saveExtraFields();
  if (cameFromPicker) {
    showRoomPicker(currentCatId);
  } else {
    showMain();
  }
}

