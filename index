      doc.rect(ML, y, CW, 14, "S");
      doc.setFont("helvetica", "bold");
      doc.setFontSize(6.5);
      doc.setTextColor(0,0,0);
      doc.text("EVALUATION CODES:", ML + 2, y + 4);
      doc.setFont("helvetica", "normal");
      doc.text("M :=Meets Minimum Requirements    C :=Comments    NA :=Not Applicable    B :=Below Minimum Requirements    SC :=Suggested Correction", ML + 2, y + 8);
      doc.text("RRE :=Repair/Replace, Evaluator Verification Required    RRP :=Repair/Replace, Permit/City Inspector Required    LIC :=Safety Check, Licensed Contractor Required", ML + 2, y + 12);
      y += 18;

      // Category heading
      doc.setFont("helvetica", "bold");
      doc.setFontSize(11);
      doc.setTextColor(0, 0, 0);
      doc.text(cat.name + roomLabel, ML, y);
      doc.setDrawColor(0, 0, 0);
      doc.setLineWidth(0.4);
      doc.line(ML, y + 1.5, W - MR, y + 1.5);
      y += 8;

      // Extra fields (Amps/Volts for Electric)
      if (cat.extraFields && room.extraData) {
        cat.extraFields.forEach(function(field) {
          var val = room.extraData[field.key] || "";
          if (val) {
            doc.setFont("helvetica", "bold");
            doc.setFontSize(9);
            doc.text(field.label + ":", ML + 4, y);
            doc.setFont("helvetica", "normal");
            doc.text(val, ML + 20, y);
            y += 5;
          }
        });
      }

      // Not applicable
      if (room.na) {
        doc.setFont("helvetica", "normal");
        doc.setFontSize(9);
        doc.text("Not Applicable", ML + 8, y);
        y += 6;
        return;
      }

      // Items
      cat.items.forEach(function(item, idx) {
        var s = room.itemStates[item.id];
        var hasAny = s.meetsReq || s.conditions.some(function(c) { return c.checked; });
        if (!hasAny) return;

        // Page break check
        if (y + 12 > H - 22) {
          doc.addPage();
          y = 14;
          doc.setFont("helvetica", "bold");
          doc.setFontSize(9);
          doc.setTextColor(0,0,0);
          doc.text("Truth in Sale of Housing Disclosure Report  -  " + address, ML, y);
          y += 6;
          doc.setDrawColor(180,180,180);
          doc.line(ML, y, W-MR, y);
          y += 6;
        }

        // Item name
        doc.setFont("helvetica", "normal");
        doc.setFontSize(9);
        doc.setTextColor(0, 0, 0);
        var itemNum = (cat.itemStartIndex || 1) + idx;
        doc.text(itemNum + ".  " + item.name, ML + 4, y);
        y += 5;

        // Meets requirements
        if (s.meetsReq) {
          doc.setFont("helvetica", "normal");
          doc.setFontSize(9);
          doc.text("M, Meets Minimum Requirements", ML + 16, y);
          y += 5;
        }

        // Checked conditions
        s.conditions.forEach(function(cst, ci) {
          if (!cst.checked) return;
          var cond = item.conditions[ci];
          var condLine = cond.code + ", " + cond.text + (cst.comment ? " - " + cst.comment : "");
          var wrapped = doc.splitTextToSize(condLine, CW - 20);
          wrapped.forEach(function(line) {
            if (y + 5 > H - 22) {
              doc.addPage();
              y = 20;
            }
            doc.setFont("helvetica", "normal");
            doc.setFontSize(9);
            doc.setTextColor(0, 0, 0);
            doc.text(line, ML + 16, y);
            y += 4.5;
          });
        });
        y += 1;
      });
    });
  });

  // ── ADD FOOTERS TO ALL PAGES ──────────────────────────────
  var totalPages = doc.internal.getNumberOfPages();
  for (var p = 1; p <= totalPages; p++) {
    doc.setPage(p);
    drawFooter(p, totalPages);
  }

  var safe = address.replace(/[^a-zA-Z0-9]/g, "_").substring(0, 30);
  
  // iOS Safari compatible - open as data URL in new tab
  try {
    var pdfData = doc.output("datauristring");
    var newTab = window.open();
    if (newTab) {
      newTab.document.write(
        "<html><head><title>TISH Report</title></head><body style='margin:0;padding:0;'>" +
        "<iframe src='" + pdfData + "' width='100%' height='100%' style='border:none;position:fixed;top:0;left:0;'></iframe>" +
        "</body></html>"
      );
      newTab.document.close();
    } else {
      // Fallback: direct data URL
      window.location.href = pdfData;
    }
  } catch(e) {
    alert("Error generating PDF: " + e.message);
  }
}

// ═══════════════════════════════════════
// INIT
// ═══════════════════════════════════════
renderMain();
</script>
</body>
</html>
