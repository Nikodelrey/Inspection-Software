// SCREEN 3 - ITEM CONDITIONS
// ═══════════════════════════════════════
function openItem(itemId) {
  currentItemId = itemId;
  var cat = categories.find(function(c) { return c.id === currentCatId; });
  var item = cat.items.find(function(i) { return i.id === itemId; });
  var room = rooms[currentCatId][currentRoomIdx];
  var s = room.itemStates[itemId];
  var roomLabel = rooms[currentCatId].length > 1 ? (" (Room " + (currentRoomIdx + 1) + ")") : "";

  var itemNum = (cat.itemStartIndex || 1) + cat.items.indexOf(item);
  document.getElementById("itemScreenBreadcrumb").textContent = cat.name + roomLabel + " > " + itemNum + ". " + item.name;

  var tbody = document.getElementById("conditionsBody");
  tbody.innerHTML = "";

  item.conditions.forEach(function(cond, idx) {
    var st = s.conditions[idx];
    var tr = document.createElement("tr");
    tr.className = "cond-row";

    var td1 = document.createElement("td");
    td1.className = "cond-check-cell";
    var chk = document.createElement("input");
    chk.type = "checkbox";
    chk.checked = st.checked;
    chk.style.cssText = "width:17px;height:17px;cursor:pointer;";
    chk.addEventListener("change", (function(iid, i) {
      return function() { rooms[currentCatId][currentRoomIdx].itemStates[iid].conditions[i].checked = this.checked; };
    })(itemId, idx));
    td1.appendChild(chk);

    var td2 = document.createElement("td");
    td2.className = "cond-text-cell";
    var codeSpan = document.createElement("span");
    codeSpan.className = "cond-code cond-code-" + cond.code;
    codeSpan.textContent = cond.code;
    td2.appendChild(codeSpan);
    td2.appendChild(document.createTextNode(" : " + cond.text));

    var td3 = document.createElement("td");
    td3.className = "cond-comment-cell";
    var inp = document.createElement("input");
    inp.type = "text";
    inp.className = "cond-comment-input";
    inp.value = st.comment || "";
    if (cond.freeText) inp.placeholder = "Enter detail...";
    inp.addEventListener("input", (function(iid, i) {
      return function() { rooms[currentCatId][currentRoomIdx].itemStates[iid].conditions[i].comment = this.value; };
    })(itemId, idx));
    td3.appendChild(inp);

    tr.appendChild(td1);
    tr.appendChild(td2);
    tr.appendChild(td3);
    tbody.appendChild(tr);
  });

  showScreen("screen-item");
}

function saveItemAndReturn() {
  showCategory();
}

