function showPDFForm() {
  var today = new Date();
  var yyyy = today.getFullYear();
  var mm = String(today.getMonth() + 1).padStart(2, "0");
  var dd = String(today.getDate()).padStart(2, "0");
  var el = document.getElementById("fi-date");
  if (el && !el.value) el.value = yyyy + "-" + mm + "-" + dd;
  showScreen("screen-form");
}

function startGeneratePDF() {
  var btn = document.getElementById("generateBtn");
  if (btn) { btn.textContent = "Generating..."; btn.disabled = true; }
  setTimeout(function() {
    try { generatePDF(); } catch(e) { alert("Error: " + e.message); }
    if (btn) { btn.textContent = "Generate PDF + XML"; btn.disabled = false; }
  }, 100);
}

// "Other Comment:" + "text" -> "Other Comment: text"; otherwise "Condition. - text"
function joinComment(text, comment) {
  var safe = String(comment || "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  if (!safe.trim()) return text;
  return /:\s*$/.test(text) ? text.replace(/\s*$/, "") + " " + safe : text + " - " + safe;
}

function generatePDF() {
  if (typeof saveNow === "function") saveNow();
  var address = document.getElementById("fi-address").value || "[Address not entered]";
  var rawDate = document.getElementById("fi-date").value || "";
  var evalDate = rawDate ? (function(d){ var p=d.split("-"); return p[1]+"/"+p[2]+"/"+p[0]; })(rawDate) : new Date().toLocaleDateString();
  var evalName = document.getElementById("fi-evalname").value || "";
  var evalPhone = document.getElementById("fi-evalphone").value || "";
  var evalNum = document.getElementById("fi-evalnum").value || "";
  var ownerName = document.getElementById("fi-ownername").value || "";
  var ownerAddress = document.getElementById("fi-owneraddress").value || "";
  var units = document.getElementById("fi-units").value || "1";
  var bldgType = document.getElementById("fi-bldgtype").value || "Single Family Home";
  var zoning = document.getElementById("fi-zoning").value || "UN1";

  var R = "#reportBody ";
  var css = "<style>#reportBody{font-family:Arial,sans-serif;font-size:12px;padding:20px;color:#000;background:#fff;}";
  css += R + "h1{font-size:18px;margin:0 0 4px 0;}";
  css += R + ".sec{font-size:12px;font-weight:bold;border-bottom:2px solid #000;padding:4px 0;margin:14px 0 4px 0;}";
  css += R + ".iname{font-size:11px;padding:3px 0 1px 8px;}";
  css += R + ".ires{font-size:10px;padding:1px 0 4px 20px;color:#333;}";
  css += R + ".codes{border:1px solid #ccc;padding:6px;margin:8px 0;font-size:9px;background:#f9f9f9;}";
  css += R + ".sig{border:1px solid #ccc;padding:8px;margin:10px 0;font-size:10px;}";
  css += R + "table{width:100%;border-collapse:collapse;}" + R + "td{padding:3px 6px;font-size:10px;vertical-align:top;}</style>";

  var h = css;
  h += "<h1>Truth in Sale of Housing Disclosure Report</h1>";
  h += "<div style='font-size:9px;color:#555;margin-bottom:6px;'>NOTICE - Read Entire Report Carefully. This is not a rental license inspection or a buyers inspection!</div>";
  h += "<div><b>Address:</b> " + address + "</div><hr>";
  h += "<table><tr><td><b>Current Owner Name:</b> " + ownerName + "</td><td><b>Contact:</b> " + ownerName + "</td></tr>";
  h += "<tr><td><b>Owner Address:</b> " + ownerAddress + "</td><td><b>Evaluation #:</b> " + evalNum + "</td></tr></table><hr>";

  var hasRR = false;
  categories.forEach(function(cat) {
    rooms[cat.id].forEach(function(room) {
      if (room.na) return;
      cat.items.forEach(function(item) {
        if (itemHasRequired(item, room.itemStates[item.id])) hasRR = true;
      });
    });
  });

  h += "<div style='text-align:center;font-weight:bold;margin:6px 0;'>" + (hasRR ? "THERE ARE REQUIRED REPAIR/REPLACE ITEMS NOTED IN THIS REPORT." : "THERE ARE NO REQUIRED REPAIR/REPLACE ITEMS IN THIS REPORT.") + "</div>";
  h += "<table><tr><td><b>Observed Number of Units:</b> " + units + "</td><td><b>Building Type:</b> " + bldgType + "</td><td><b>Zoning:</b> " + zoning + "</td></tr></table><hr>";

  h += "<div class='codes'><b>EVALUATION CODES:</b><br>";
  h += "M=Meets Requirements &nbsp; C=Comments &nbsp; NA=Not Applicable &nbsp; B=Below Minimum Requirements &nbsp; SC=Suggested Correction<br>";
  h += "RRE=Repair/Replace, Evaluator Verification Required &nbsp; RRP=Repair/Replace, Permit Required &nbsp; LIC=Safety Check, Licensed Contractor Required</div>";

  categories.forEach(function(cat) {
    rooms[cat.id].forEach(function(room, ri) {
      var rlabel = rooms[cat.id].length > 1 ? (" (" + (room.label || ("Room " + (ri+1))) + ")") : "";
      var hasContent = room.na || Object.keys(room.itemStates).some(function(k) {
        var st = room.itemStates[k];
        return st.meetsReq || st.conditions.some(function(c) { return c.checked; });
      }) || Object.keys(room.extraData || {}).some(function(k) { return room.extraData[k]; });
      if (!hasContent) return;

      h += "<div class='sec'>" + cat.name + rlabel + "</div>";

      if (cat.extraFields && room.extraData) {
        cat.extraFields.forEach(function(f) {
          var v = room.extraData[f.key] || "";
          if (v) h += "<div style='font-size:10px;font-weight:bold;padding:2px 0;'>" + f.label.replace(/:$/, "") + ": " + v + "</div>";
        });
      }

      if (room.na) { h += "<div class='ires'>Not Applicable</div>"; return; }

      var area = room.itemStates[AREA_ID];
      if (area && area.conditions.some(function(c) { return c.checked; })) {
        h += "<div class='iname'>General Area</div>";
        area.conditions.forEach(function(cst, ci) {
          if (!cst.checked) return;
          h += "<div class='ires'>" + joinComment(cat.areaConditions[ci].text, cst.comment) + "</div>";
        });
      }

      cat.items.forEach(function(item, idx) {
        var s = room.itemStates[item.id];
        var hasAny = s.meetsReq || s.conditions.some(function(c) { return c.checked; });
        if (!hasAny) return;
        var num = (cat.itemStartIndex || 1) + idx;
        h += "<div class='iname'>" + num + ". " + item.name + "</div>";
        if (s.meetsReq) h += "<div class='ires'>M, Meets Minimum Requirements</div>";
        s.conditions.forEach(function(cst, ci) {
          if (!cst.checked) return;
          var cond = item.conditions[ci];
          h += "<div class='ires'>" + cond.code + ", " + joinComment(cond.text, cst.comment) + "</div>";
        });
      });
    });
  });

  h += "<div class='sig'>";
  h += "<div style='margin-bottom:6px;font-size:9px;'>I hereby certify that this report is made in compliance with the Minneapolis Code of Ordinances, Chapter 248.</div>";
  h += "<table><tr><td><b>Evaluator Name:</b> " + evalName + "</td><td><b>Phone:</b> " + evalPhone + "</td><td><b>Evaluation Date:</b> " + evalDate + "</td></tr>";
  h += "<tr><td><b>Signature:</b> <i>" + evalName + "</i></td><td></td><td><b>Evaluation #:</b> " + evalNum + "</td></tr></table></div>";
  h += "<hr><div style='font-size:9px;text-align:center;color:#555;'>City of Minneapolis - Truth in Sale of Housing - 505 Fourth Ave S, Rm 320 - 612-673-5840</div>";

  document.getElementById("reportBody").innerHTML = h;
  document.title = "Report - " + address;
  showScreen("screen-report");
}

function closeReport() {
  document.title = "Inspection Report";
  showScreen("screen-form");
}


// =======================================
// XML EXPORT (provisional format)
// Structure is our own until the City supplies its official schema.
// Everything the City could need is included (item numbers, internal ids,
// condition positions, codes, text and comments) so the output can be
// re-mapped to the official format later without re-entering inspections.
// =======================================
var XML_FORMAT_VERSION = "provisional-1";

function xmlEsc(s) {
  return String(s == null ? "" : s)
    .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;").replace(/'/g, "&apos;");
}

function getFormInfo() {
  function v(id) { var el = document.getElementById(id); return el ? el.value : ""; }
  return {
    address: v("fi-address"), evalName: v("fi-evalname"), evalPhone: v("fi-evalphone"),
    date: v("fi-date"), evalNum: v("fi-evalnum"), ownerName: v("fi-ownername"),
    ownerAddress: v("fi-owneraddress"), units: v("fi-units"), bldgType: v("fi-bldgtype"), zoning: v("fi-zoning")
  };
}

function buildXML() {
  var f = getFormInfo();
  var hasRR = false;
  categories.forEach(function(cat) {
    rooms[cat.id].forEach(function(room) {
      if (room.na) return;
      cat.items.forEach(function(item) { if (itemHasRequired(item, room.itemStates[item.id])) hasRR = true; });
    });
  });

  var x = [];
  x.push('<?xml version="1.0" encoding="UTF-8"?>');
  x.push('<EvaluationReport formatVersion="' + XML_FORMAT_VERSION + '" city="Minneapolis" generatedAt="' + new Date().toISOString() + '">');
  x.push('  <Evaluation>');
  x.push('    <EvaluationNumber>' + xmlEsc(f.evalNum) + '</EvaluationNumber>');
  x.push('    <EvaluationDate>' + xmlEsc(f.date) + '</EvaluationDate>');
  x.push('    <HasRequiredRepairs>' + hasRR + '</HasRequiredRepairs>');
  x.push('  </Evaluation>');
  x.push('  <Property>');
  x.push('    <Address>' + xmlEsc(f.address) + '</Address>');
  x.push('    <ObservedUnits>' + xmlEsc(f.units) + '</ObservedUnits>');
  x.push('    <BuildingType>' + xmlEsc(f.bldgType) + '</BuildingType>');
  x.push('    <Zoning>' + xmlEsc(f.zoning) + '</Zoning>');
  x.push('  </Property>');
  x.push('  <Owner>');
  x.push('    <Name>' + xmlEsc(f.ownerName) + '</Name>');
  x.push('    <Address>' + xmlEsc(f.ownerAddress) + '</Address>');
  x.push('  </Owner>');
  x.push('  <Evaluator>');
  x.push('    <Name>' + xmlEsc(f.evalName) + '</Name>');
  x.push('    <Phone>' + xmlEsc(f.evalPhone) + '</Phone>');
  x.push('  </Evaluator>');
  x.push('  <Areas>');

  categories.forEach(function(cat) {
    rooms[cat.id].forEach(function(room, ri) {
      x.push('    <Area id="' + xmlEsc(cat.id) + '" name="' + xmlEsc(cat.name) + '" roomNumber="' + (ri + 1) +
             '" label="' + xmlEsc(room.label) + '" notApplicable="' + !!room.na + '">');

      if (cat.extraFields) {
        x.push('      <AreaInformation>');
        cat.extraFields.forEach(function(fd) {
          x.push('        <Field key="' + xmlEsc(fd.key) + '" label="' + xmlEsc(fd.label.replace(/:$/, "")) + '">' +
                 xmlEsc(room.extraData[fd.key] || "") + '</Field>');
        });
        x.push('      </AreaInformation>');
      }

      var area = room.itemStates[AREA_ID];
      if (cat.areaConditions && area) {
        x.push('      <GeneralAreaComments>');
        area.conditions.forEach(function(cst, ci) {
          if (!cst.checked) return;
          x.push('        <AreaComment position="' + (ci + 1) + '" text="' + xmlEsc(cat.areaConditions[ci].text) + '">' +
                 xmlEsc(cst.comment) + '</AreaComment>');
        });
        x.push('      </GeneralAreaComments>');
      }

      if (cat.items.length) {
        x.push('      <Items>');
        cat.items.forEach(function(item, idx) {
          var s = room.itemStates[item.id];
          var num = (cat.itemStartIndex || 1) + idx;
          x.push('        <Item number="' + num + '" id="' + xmlEsc(item.id) + '" name="' + xmlEsc(item.name) +
                 '" meetsRequirements="' + !!s.meetsReq + '">');
          s.conditions.forEach(function(cst, ci) {
            if (!cst.checked) return;
            var cond = item.conditions[ci];
            x.push('          <Condition position="' + (ci + 1) + '" code="' + xmlEsc(cond.code) + '" required="' +
                   isRequired(cond.code) + '" text="' + xmlEsc(cond.text) + '">' + xmlEsc(cst.comment) + '</Condition>');
          });
          x.push('        </Item>');
        });
        x.push('      </Items>');
      }
      x.push('    </Area>');
    });
  });

  x.push('  </Areas>');
  x.push('</EvaluationReport>');
  return x.join("\n");
}

function xmlFileName() {
  var f = getFormInfo();
  var base = f.evalNum || f.address || "report";
  base = base.replace(/[^A-Za-z0-9]+/g, "_").replace(/^_+|_+$/g, "").slice(0, 60) || "report";
  return "Report_" + base + "_" + (f.date || new Date().toISOString().slice(0, 10)) + ".xml";
}

function downloadXML() {
  var blob = new Blob([buildXML()], { type: "application/xml;charset=utf-8" });
  var url = URL.createObjectURL(blob);
  var a = document.createElement("a");
  a.href = url;
  a.download = xmlFileName();
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  setTimeout(function() { URL.revokeObjectURL(url); }, 10000);
}

function runXMLOnly() {
  try { downloadXML(); } catch (e) { alert("XML error: " + e.message); }
}

// Runs directly in the tap handler so Safari allows both the report window and the download.
function generateBoth() {
  try { downloadXML(); } catch (e) { alert("XML error: " + e.message); }
  try { generatePDF(); } catch (e) { alert("PDF error: " + e.message); }
}


// =======================================
// SAVE / LOAD
// Every inspection auto-saves to this browser (localStorage) as you work.
// Saved by category id, item id and condition position.
// =======================================
var STORE_KEY = "insp.records.v1";
var CUR_KEY = "insp.currentId.v1";
// One-time move of inspections saved under the earlier storage names
(function migrateOldKeys() {
  try {
    var OLD_STORE = ["t","ish.inspections.v1"].join(""), OLD_CUR = ["t","ish.currentId.v1"].join("");
    if (!localStorage.getItem(STORE_KEY) && localStorage.getItem(OLD_STORE)) {
      localStorage.setItem(STORE_KEY, localStorage.getItem(OLD_STORE));
      if (localStorage.getItem(OLD_CUR)) localStorage.setItem(CUR_KEY, localStorage.getItem(OLD_CUR));
    }
    if (localStorage.getItem(STORE_KEY)) { localStorage.removeItem(OLD_STORE); localStorage.removeItem(OLD_CUR); }
  } catch (e) {}
})();
var FORM_IDS = ["fi-address","fi-evalname","fi-evalphone","fi-date","fi-evalnum","fi-ownername","fi-owneraddress","fi-units","fi-bldgtype","fi-zoning"];
var FORM_DEFAULTS = { "fi-units":"1", "fi-bldgtype":"Single Family Home", "fi-zoning":"UN1" };
var currentInspId = null;
var storageOK = true;
var saveTimer = null;
var lastSavedAt = null;

function loadAll() {
  try { var s = localStorage.getItem(STORE_KEY); return s ? JSON.parse(s) : {}; }
  catch (e) { storageOK = false; return {}; }
}
function writeAll(all) {
  try { localStorage.setItem(STORE_KEY, JSON.stringify(all)); storageOK = true; return true; }
  catch (e) { storageOK = false; return false; }
}
function setCurrentId(id) {
  currentInspId = id;
  try { localStorage.setItem(CUR_KEY, id); } catch (e) {}
}
function newId() { return "i" + Date.now().toString(36) + Math.random().toString(36).slice(2, 6); }

function readForm() {
  var f = {};
  FORM_IDS.forEach(function(id) { var el = document.getElementById(id); f[id] = el ? el.value : ""; });
  return f;
}
function writeForm(f) {
  FORM_IDS.forEach(function(id) {
    var el = document.getElementById(id);
    if (el) el.value = (f && f[id] != null) ? f[id] : (FORM_DEFAULTS[id] || "");
  });
}
function inspTitle(form) {
  var a = (form["fi-address"] || "").trim();
  var n = (form["fi-evalnum"] || "").trim();
  return a || (n ? "Evaluation #" + n : "Untitled inspection");
}

// True once anything has been entered (date alone does not count; it is auto-filled)
function hasData() {
  var f = readForm();
  for (var i = 0; i < FORM_IDS.length; i++) {
    var id = FORM_IDS[i];
    if (id === "fi-date") continue;
    if ((f[id] || "") !== (FORM_DEFAULTS[id] || "")) return true;
  }
  return categories.some(function(cat) {
    var list = rooms[cat.id];
    if (list.length > 1) return true;
    return list.some(function(r) {
      if (r.label || r.na) return true;
      if (Object.keys(r.extraData).some(function(k) { return r.extraData[k]; })) return true;
      return Object.keys(r.itemStates).some(function(k) {
        var s = r.itemStates[k];
        return s.meetsReq || s.conditions.some(function(c) { return c.checked || c.comment; });
      });
    });
  });
}

function saveNow() {
  clearTimeout(saveTimer);
  if (!currentInspId) return;
  var all = loadAll();
  var prev = all[currentInspId];
  if (!prev && !hasData()) { renderSaveBar(); return; }
  var form = readForm();
  var now = new Date();
  all[currentInspId] = {
    id: currentInspId,
    createdAt: prev ? prev.createdAt : now.toISOString(),
    savedAt: now.toISOString(),
    title: inspTitle(form),
    form: form,
    rooms: rooms
  };
  if (writeAll(all)) lastSavedAt = now;
  renderSaveBar();
}
function scheduleSave() {
  clearTimeout(saveTimer);
  saveTimer = setTimeout(saveNow, 400);
}

// Rebuild fresh room states from the current data, then copy saved values in.
function restoreRooms(saved) {
  var out = {};
  categories.forEach(function(cat) {
    var list = (saved && saved[cat.id] && saved[cat.id].length) ? saved[cat.id] : [null];
    out[cat.id] = list.map(function(sr) {
      var r = makeRoomState(cat);
      if (!sr) return r;
      r.label = sr.label || "";
      r.na = !!sr.na;
      Object.keys(r.extraData).forEach(function(k) {
        if (sr.extraData && sr.extraData[k] != null) r.extraData[k] = sr.extraData[k];
      });
      Object.keys(r.itemStates).forEach(function(iid) {
        var ss = sr.itemStates && sr.itemStates[iid];
        if (!ss) return;
        var ts = r.itemStates[iid];
        ts.meetsReq = !!ss.meetsReq;
        ts.conditions.forEach(function(c, i) {
          var sc = ss.conditions && ss.conditions[i];
          if (sc) { c.checked = !!sc.checked; c.comment = sc.comment || ""; }
        });
      });
      return r;
    });
  });
  return out;
}

function fmtTime(d) {
  var t = d.toLocaleTimeString([], { hour: "numeric", minute: "2-digit" });
  var today = new Date().toDateString() === d.toDateString();
  return today ? t : d.toLocaleDateString() + " " + t;
}

function renderSaveBar() {
  var bar = document.getElementById("saveBar");
  if (!bar) return;
  var title = inspTitle(readForm());
  var status;
  if (!storageOK) status = "<span style='color:#cc3300;'>Saving unavailable in this browser</span>";
  else if (lastSavedAt) status = "Saved " + fmtTime(lastSavedAt);
  else status = "Not saved yet (saves when you start)";
  bar.innerHTML = "";
  var left = document.createElement("div");
  left.innerHTML = "<div style='font-weight:bold;font-size:14px;color:#1a2744;'></div><div style='font-size:12px;color:#555;'>" + status + "</div>";
  left.firstChild.textContent = title;
  var right = document.createElement("div");
  right.style.cssText = "display:flex;gap:8px;";
  var b1 = document.createElement("button");
  b1.className = "btn-add"; b1.textContent = "Inspections";
  b1.addEventListener("click", showInspections);
  var b2 = document.createElement("button");
  b2.className = "btn-add"; b2.textContent = "New";
  b2.addEventListener("click", function() { newInspection(true); });
  right.appendChild(b1); right.appendChild(b2);
  bar.appendChild(left); bar.appendChild(right);
}

function showInspections() {
  saveNow();
  var all = loadAll();
  var list = Object.keys(all).map(function(k) { return all[k]; })
    .sort(function(a, b) { return (b.savedAt || "").localeCompare(a.savedAt || ""); });
  var box = document.getElementById("inspList");
  box.innerHTML = "";
  if (!list.length) {
    box.innerHTML = "<p style='font-size:13px;color:#777;padding:10px 0;'>No saved inspections yet.</p>";
  }
  list.forEach(function(rec) {
    var row = document.createElement("div");
    row.style.cssText = "display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 0;border-bottom:1px solid #ddd;";
    var info = document.createElement("button");
    info.className = "main-link";
    info.style.flex = "1";
    var num = rec.form && rec.form["fi-evalnum"] ? "Eval #" + rec.form["fi-evalnum"] + " \u00B7 " : "";
    info.innerHTML = "<span></span><div style='font-size:11px;color:#666;font-weight:normal;text-decoration:none;'></div>";
    info.firstChild.textContent = rec.title + (rec.id === currentInspId ? "  (open now)" : "");
    info.lastChild.textContent = num + "Saved " + fmtTime(new Date(rec.savedAt));
    info.addEventListener("click", function() { openInspection(rec.id); });
    var del = document.createElement("button");
    del.textContent = "Delete";
    del.style.cssText = "background:none;border:1px solid #cc3300;color:#cc3300;border-radius:4px;padding:5px 12px;font-size:12px;cursor:pointer;";
    del.addEventListener("click", function() { deleteInspection(rec.id, rec.title); });
    row.appendChild(info); row.appendChild(del);
    box.appendChild(row);
  });
  showScreen("screen-inspections");
}

function openInspection(id) {
  saveNow();
  var rec = loadAll()[id];
  if (!rec) { alert("That inspection could not be found."); return; }
  rooms = restoreRooms(rec.rooms);
  writeForm(rec.form);
  setCurrentId(id);
  lastSavedAt = rec.savedAt ? new Date(rec.savedAt) : null;
  showMain();
}

function newInspection(ask) {
  if (ask && hasData() && !confirm("Start a new inspection? The current one stays saved under Inspections.")) return;
  saveNow();
  rooms = restoreRooms(null);
  writeForm({});
  setCurrentId(newId());
  lastSavedAt = null;
  showMain();
}

function deleteInspection(id, title) {
  if (!confirm("Delete \"" + title + "\"? This cannot be undone.")) return;
  var all = loadAll();
  delete all[id];
  writeAll(all);
  if (id === currentInspId) {
    rooms = restoreRooms(null);
    writeForm({});
    setCurrentId(newId());
    lastSavedAt = null;
  }
  showInspections();
}

function exportBackup() {
  saveNow();
  var all = loadAll();
  var data = { format: "insp-backup", version: 1, exportedAt: new Date().toISOString(),
               inspections: Object.keys(all).map(function(k) { return all[k]; }) };
  var blob = new Blob([JSON.stringify(data, null, 1)], { type: "application/json" });
  var url = URL.createObjectURL(blob);
  var a = document.createElement("a");
  a.href = url;
  a.download = "Inspections_backup_" + new Date().toISOString().slice(0, 10) + ".json";
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  setTimeout(function() { URL.revokeObjectURL(url); }, 10000);
}

function importBackup(input) {
  var file = input.files && input.files[0];
  if (!file) return;
  var reader = new FileReader();
  reader.onload = function() {
    try {
      var data = JSON.parse(reader.result);
      if (!data || !/-backup$/.test(data.format || "") || !data.inspections) throw new Error("Not an inspection backup file.");
      var all = loadAll();
      var added = 0, replaced = 0;
      data.inspections.forEach(function(rec) {
        if (!rec || !rec.id || !rec.rooms) return;
        if (all[rec.id]) replaced++; else added++;
        all[rec.id] = rec;
      });
      if (!writeAll(all)) throw new Error("Could not save to this browser.");
      alert("Backup imported: " + added + " added, " + replaced + " updated.");
      if (all[currentInspId]) openInspection(currentInspId); else showInspections();
      if (document.getElementById("screen-inspections").style.display === "block") showInspections();
    } catch (e) {
      alert("Import failed: " + e.message);
    }
    input.value = "";
  };
  reader.readAsText(file);
}

// Save on every edit, and when leaving or hiding the page
document.addEventListener("input", scheduleSave);
document.addEventListener("change", scheduleSave);
document.addEventListener("visibilitychange", function() { if (document.visibilityState === "hidden") saveNow(); });
window.addEventListener("pagehide", saveNow);

// Startup: reopen the last inspection if there is one
(function initSave() {
  var all = loadAll();
  var cur = null;
  try { cur = localStorage.getItem(CUR_KEY); } catch (e) { storageOK = false; }
  if (cur && all[cur]) {
    rooms = restoreRooms(all[cur].rooms);
    writeForm(all[cur].form);
    currentInspId = cur;
    lastSavedAt = all[cur].savedAt ? new Date(all[cur].savedAt) : null;
  } else {
    setCurrentId(newId());
  }
})();

renderMain();
renderSaveBar();
</script>
