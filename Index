<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>Inspection Report</title>
<style>

* { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: Arial, Helvetica, sans-serif;
  font-size: 15px;
  background: #fff;
  color: #222;
  max-width: 700px;
  margin: 0 auto;
  min-height: 100vh;
}

/* ── SCREEN 1 — MAIN MENU ─────────────────────────────── */
#screen-main { display: block; }
#screen-category { display: none; }
#screen-item { display: none; }

.page-intro {
  padding: 14px 16px 10px;
  font-size: 14px;
  line-height: 1.5;
  color: #333;
}

.main-table {
  width: 100%;
  border-collapse: collapse;
  border: 1px solid #bbb;
}

.main-table th {
  background: #e8e8e8;
  border: 1px solid #bbb;
  padding: 10px 14px;
  text-align: left;
  font-size: 15px;
  font-weight: bold;
}

.main-table td {
  border: 1px solid #ddd;
  padding: 10px 14px;
  vertical-align: middle;
}

.main-table tr:nth-child(even) td { background: #f5f5f5; }
.main-table tr:nth-child(odd) td { background: #fff; }

.main-link {
  color: #1a56cc;
  text-decoration: underline;
  font-weight: bold;
  font-size: 15px;
  cursor: pointer;
  background: none;
  border: none;
  padding: 0;
  font-family: inherit;
  display: block;
  width: 100%;
  text-align: left;
}

.main-link:active { color: #003a99; }

.add-room-cell { text-align: right; width: 90px; }

.btn-add {
  background: #5b9bd5;
  color: white;
  border: none;
  border-radius: 5px;
  padding: 7px 16px;
  font-size: 14px;
  cursor: pointer;
  font-weight: bold;
  -webkit-tap-highlight-color: transparent;
}

.btn-add:active { background: #3a7abf; }

/* ── SCREEN 2 — CATEGORY ──────────────────────────────── */
.cat-header-box {
  background: #dce6f0;
  border: 1px solid #aac0d8;
  border-bottom: none;
  padding: 10px 14px;
}

.cat-header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 8px;
}

.cat-title-row {
  display: flex;
  align-items: center;
  gap: 8px;
}

.cat-screen-title {
  font-size: 17px;
  font-weight: bold;
  color: #1a1a1a;
}

.na-checkbox-wrap {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 14px;
  font-weight: bold;
  white-space: nowrap;
}

.na-checkbox-wrap input[type=checkbox] {
  width: 18px; height: 18px;
  cursor: pointer;
}

.area-comment-row {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 14px;
  font-weight: bold;
}

.area-comment-row .area-note {
  font-size: 11px;
  color: #cc3300;
  font-style: italic;
  font-weight: normal;
}

.label-row {
  background: #f5f7fa;
  border: 1px solid #aac0d8;
  border-bottom: none;
  padding: 8px 14px;
}

.label-row label { font-size: 11px; color: #555; display: block; margin-bottom: 4px; }

.label-input {
  border: 1px solid #bbb;
  border-radius: 3px;
  padding: 5px 10px;
  font-size: 14px;
  font-family: inherit;
  width: 180px;
  outline: none;
}

.cat-items-table {
  width: 100%;
  border-collapse: collapse;
  border: 1px solid #bbb;
}

.cat-items-table th {
  background: #f0f0f0;
  border-bottom: 2px solid #bbb;
  padding: 9px 14px;
  text-align: left;
  font-size: 14px;
  font-weight: bold;
}

.cat-items-table th:last-child { text-align: right; }

.select-all-row td {
  padding: 8px 14px;
  border-bottom: 1px solid #e0e0e0;
  background: #fafafa;
}

.select-all-row td label {
  display: flex;
  align-items: center;
  gap: 8px;
  font-weight: bold;
  font-size: 14px;
  cursor: pointer;
}

.select-all-row input[type=checkbox] { width: 18px; height: 18px; cursor: pointer; }

.item-row td {
  padding: 10px 14px;
  border-bottom: 1px solid #e8e8e8;
  vertical-align: middle;
}

.item-row:hover td { background: #f0f5ff; }

.item-check-cell { width: 40px; }
.item-check-cell input[type=checkbox] { width: 18px; height: 18px; cursor: pointer; }

.item-name-btn {
  color: #1a56cc;
  font-weight: bold;
  font-size: 14px;
  text-decoration: underline;
  background: none;
  border: none;
  cursor: pointer;
  font-family: inherit;
  text-align: left;
  padding: 0;
  display: block;
  width: 100%;
}

.item-name-btn:active { color: #003a99; }

.item-comment-cell { width: 100px; text-align: right; }

.btn-comment-add {
  background: #5b9bd5;
  color: white;
  border: none;
  border-radius: 5px;
  padding: 6px 14px;
  font-size: 13px;
  cursor: pointer;
  font-weight: bold;
}

.btn-comment-add:active { background: #3a7abf; }

.item-rr-indicator {
  display: inline-block;
  width: 9px; height: 9px;
  background: #cc3300;
  border-radius: 50%;
  margin-left: 6px;
  vertical-align: middle;
  flex-shrink: 0;
}

.cat-actions {
  display: flex;
  justify-content: space-between;
  padding: 12px 14px;
  border-top: 1px solid #ddd;
  background: #fafafa;
}

.btn-cancel {
  background: #5b9bd5;
  color: white;
  border: none;
  border-radius: 5px;
  padding: 9px 20px;
  font-size: 14px;
  cursor: pointer;
  font-weight: bold;
}

.btn-save {
  background: #5b9bd5;
  color: white;
  border: none;
  border-radius: 5px;
  padding: 9px 20px;
  font-size: 14px;
  cursor: pointer;
  font-weight: bold;
}

.btn-cancel:active, .btn-save:active { background: #3a7abf; }

/* ── SCREEN 3 — ITEM CONDITIONS ───────────────────────── */
.item-screen-header {
  padding: 12px 14px 8px;
  border-bottom: 2px solid #bbb;
}

.item-screen-title {
  font-size: 16px;
  font-weight: bold;
  color: #1a2744;
  margin-bottom: 2px;
}

.item-screen-breadcrumb {
  font-size: 12px;
  color: #777;
}

.conditions-table {
  width: 100%;
  border-collapse: collapse;
}

.conditions-table .col-head-cond {
  width: 55%;
  padding: 9px 14px;
  background: #f0f0f0;
  border-bottom: 2px solid #bbb;
  font-size: 14px;
  font-weight: bold;
}

.conditions-table .col-head-comment {
  padding: 9px 14px;
  background: #f0f0f0;
  border-bottom: 2px solid #bbb;
  font-size: 14px;
  font-weight: bold;
}

.cond-row td {
  padding: 8px 12px;
  border-bottom: 1px solid #e8e8e8;
  vertical-align: middle;
}

.cond-row:hover td { background: #f5f8ff; }

.cond-check-cell { width: 36px; }
.cond-check-cell input[type=checkbox] { width: 17px; height: 17px; cursor: pointer; }

.cond-text-cell { font-size: 13px; line-height: 1.4; }

.cond-code {
  font-weight: bold;
  color: #444;
}

.cond-code-B { color: #1a56cc; }
.cond-code-SC { color: #cc7700; }
.cond-code-RRE { color: #cc3300; }
.cond-code-RRP { color: #cc3300; }
.cond-code-C { color: #555; }
.cond-code-LIC { color: #7a00cc; }
.cond-code-NA { color: #777; }

.cond-comment-cell { }

.cond-comment-input {
  width: 100%;
  border: 1px solid #ccc;
  border-radius: 3px;
  padding: 5px 8px;
  font-size: 13px;
  font-family: inherit;
  outline: none;
  background: #fafafa;
  transition: border-color 0.15s;
}

.cond-comment-input:focus { border-color: #5b9bd5; background: #fff; }

.item-actions {
  display: flex;
  justify-content: space-between;
  padding: 12px 14px;
  border-top: 1px solid #ddd;
  background: #fafafa;
  margin-top: 4px;
}

.btn-next {
  background: #5b9bd5;
  color: white;
  border: none;
  border-radius: 5px;
  padding: 9px 20px;
  font-size: 14px;
  cursor: pointer;
  font-weight: bold;
}

.btn-next:active { background: #3a7abf; }

/* ── MAIN TOP BAR ─────────────────────────────────────── */
.top-bar {
  background: #1a2744;
  color: white;
  padding: 10px 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: sticky;
  top: 0;
  z-index: 50;
}

.top-bar-title {
  font-size: 15px;
  font-weight: bold;
  letter-spacing: 0.3px;
}

.btn-pdf-top {
  background: #d4af37;
  color: #1a2744;
  border: none;
  border-radius: 5px;
  padding: 6px 13px;
  font-size: 12px;
  font-weight: bold;
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}

.btn-pdf-top:active { background: #b8971e; }

/* Room count badge */
.room-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #cc3300;
  color: white;
  border-radius: 50%;
  width: 18px; height: 18px;
  font-size: 10px;
  font-weight: bold;
  margin-left: 6px;
  vertical-align: middle;
}

/* Inline comment display under item in cat screen */
.item-inline-comment {
  font-size: 11px;
  color: #cc3300;
  font-style: italic;
  margin-top: 3px;
}


@page { margin: 15mm; }
@media print {
  body { max-width: none; margin: 0; }
  body > * { display: none !important; }
  body > #screen-report { display: block !important; }
  #screen-report .no-print { display: none !important; }
  #reportBody { padding: 0 !important; }
}
</style>
</head>
<body>

<!-- TOP BAR -->
<div class="top-bar">
  <span class="top-bar-title">Inspection Report</span>
  <button class="btn-pdf-top" onclick="showPDFForm()">PDF / XML</button>
</div>

<!-- SCREEN 0: PROPERTY INFO FORM -->
<div id="screen-form" style="display:none;">
  <div style="background:#1a2744;color:white;padding:12px 16px;font-size:16px;font-weight:bold;">
    Property Information
  </div>
  <div style="padding:14px 16px;max-width:640px;margin:0 auto;">
    <p style="font-size:13px;color:#555;margin-bottom:14px;">Fill in the property details before generating your PDF report.</p>

    <div style="display:grid;gap:10px;">
      <div>
        <label style="font-size:12px;font-weight:bold;color:#333;display:block;margin-bottom:3px;">Property Address *</label>
        <input id="fi-address" type="text" placeholder="Street address, city, zip"
          style="width:100%;border:1px solid #ccc;border-radius:5px;padding:8px 10px;font-size:14px;font-family:inherit;outline:none;">
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
        <div>
          <label style="font-size:12px;font-weight:bold;color:#333;display:block;margin-bottom:3px;">Evaluator Name</label>
          <input id="fi-evalname" type="text" placeholder="Full name"
            style="width:100%;border:1px solid #ccc;border-radius:5px;padding:8px 10px;font-size:14px;font-family:inherit;outline:none;">
        </div>
        <div>
          <label style="font-size:12px;font-weight:bold;color:#333;display:block;margin-bottom:3px;">Evaluator Phone</label>
          <input id="fi-evalphone" type="tel" placeholder="612-000-0000"
            style="width:100%;border:1px solid #ccc;border-radius:5px;padding:8px 10px;font-size:14px;font-family:inherit;outline:none;">
        </div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
        <div>
          <label style="font-size:12px;font-weight:bold;color:#333;display:block;margin-bottom:3px;">Evaluation Date</label>
          <input id="fi-date" type="date"
            style="width:100%;border:1px solid #ccc;border-radius:5px;padding:8px 10px;font-size:14px;font-family:inherit;outline:none;">
        </div>
        <div>
          <label style="font-size:12px;font-weight:bold;color:#333;display:block;margin-bottom:3px;">Evaluation #</label>
          <input id="fi-evalnum" type="text" placeholder="Evaluation number"
            style="width:100%;border:1px solid #ccc;border-radius:5px;padding:8px 10px;font-size:14px;font-family:inherit;outline:none;">
        </div>
      </div>
      <div>
        <label style="font-size:12px;font-weight:bold;color:#333;display:block;margin-bottom:3px;">Current Owner Name</label>
        <input id="fi-ownername" type="text" placeholder="Owner full name"
          style="width:100%;border:1px solid #ccc;border-radius:5px;padding:8px 10px;font-size:14px;font-family:inherit;outline:none;">
      </div>
      <div>
        <label style="font-size:12px;font-weight:bold;color:#333;display:block;margin-bottom:3px;">Owner Address</label>
        <input id="fi-owneraddress" type="text" placeholder="Street address, city, state, zip"
          style="width:100%;border:1px solid #ccc;border-radius:5px;padding:8px 10px;font-size:14px;font-family:inherit;outline:none;">
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;">
        <div>
          <label style="font-size:12px;font-weight:bold;color:#333;display:block;margin-bottom:3px;">Units</label>
          <input id="fi-units" type="text" value="1"
            style="width:100%;border:1px solid #ccc;border-radius:5px;padding:8px 10px;font-size:14px;font-family:inherit;outline:none;">
        </div>
        <div>
          <label style="font-size:12px;font-weight:bold;color:#333;display:block;margin-bottom:3px;">Building Type</label>
          <input id="fi-bldgtype" type="text" value="Single Family Home"
            style="width:100%;border:1px solid #ccc;border-radius:5px;padding:8px 10px;font-size:14px;font-family:inherit;outline:none;">
        </div>
        <div>
          <label style="font-size:12px;font-weight:bold;color:#333;display:block;margin-bottom:3px;">Zoning</label>
          <input id="fi-zoning" type="text" value="UN1"
            style="width:100%;border:1px solid #ccc;border-radius:5px;padding:8px 10px;font-size:14px;font-family:inherit;outline:none;">
        </div>
      </div>
    </div>

    <div style="display:flex;gap:10px;margin-top:20px;padding-bottom:30px;">
      <button onclick="showMain()" style="background:none;border:1px solid #ccc;border-radius:6px;padding:12px 20px;font-size:14px;font-family:inherit;cursor:pointer;color:#555;">
        Cancel
      </button>
      <button id="generateBtn" onclick="generateBoth()" style="flex:1;background:#1a2744;color:white;border:none;border-radius:6px;padding:12px 20px;font-size:15px;font-weight:bold;font-family:inherit;cursor:pointer;">
        Generate PDF + XML
      </button>
    </div>
    <div style="display:flex;gap:10px;margin-top:-18px;padding-bottom:30px;">
      <button onclick="startGeneratePDF()" style="flex:1;background:none;border:1px solid #1a2744;border-radius:6px;padding:10px;font-size:13px;font-family:inherit;cursor:pointer;color:#1a2744;">PDF only</button>
      <button onclick="runXMLOnly()" style="flex:1;background:none;border:1px solid #1a2744;border-radius:6px;padding:10px;font-size:13px;font-family:inherit;cursor:pointer;color:#1a2744;">XML only</button>
    </div>
    <p style="font-size:11px;color:#777;padding-bottom:30px;margin-top:-20px;">XML format is provisional until the City provides its official specification.</p>
  </div>
</div>

<!-- SCREEN 1: MAIN MENU -->
<div id="screen-main">
  <div id="saveBar" style="display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 14px;background:#eef3f9;border-bottom:1px solid #cdd9e6;flex-wrap:wrap;"></div>
  <p class="page-intro">Click on each area of property to complete report. When all areas are complete confirm agreement and date of evaluation then press Submit Report.</p>
  <table class="main-table">
    <thead>
      <tr>
        <th>Evaluation Report</th>
        <th style="text-align:right">Add Room</th>
      </tr>
    </thead>
    <tbody id="mainTableBody"></tbody>
  </table>
</div>

<!-- SCREEN: REPORT (print / save as PDF) -->
<div id="screen-report" style="display:none;">
  <div class="no-print" style="background:#eef3f9;border-bottom:1px solid #cdd9e6;padding:10px 14px;display:flex;gap:8px;flex-wrap:wrap;">
    <button class="btn-cancel" onclick="closeReport()">Back</button>
    <button class="btn-pdf-top" style="font-size:14px;padding:9px 16px;" onclick="window.print()">Print / Save as PDF</button>
    <button class="btn-save" onclick="runXMLOnly()">Download XML</button>
  </div>
  <div class="no-print" style="padding:8px 14px;font-size:12px;line-height:1.5;background:#fff8dc;border-bottom:1px solid #eee2b0;">
    <b>To save the PDF:</b> tap <b>Print / Save as PDF</b>, then tap the <b>Share</b> button at the top of the print screen and choose <b>Save to Files</b>.
  </div>
  <div id="reportBody"></div>
</div>

<!-- SCREEN: SAVED INSPECTIONS -->
<div id="screen-inspections" style="display:none;">
  <div style="background:#1a2744;color:white;padding:12px 14px;font-size:16px;font-weight:bold;">Saved Inspections</div>
  <p style="padding:12px 14px 4px;font-size:13px;color:#555;">Inspections save automatically on this iPad. Tap one to open it.</p>
  <div id="inspList" style="padding:0 14px;"></div>
  <div style="display:flex;gap:10px;padding:14px;">
    <button class="btn-cancel" onclick="showMain()">Back</button>
    <button class="btn-add" style="flex:1;padding:10px;" onclick="newInspection(true)">+ New Inspection</button>
  </div>
  <div style="margin:6px 14px 30px;padding:12px;border:1px solid #ddd;border-radius:6px;background:#fafafa;">
    <div style="font-weight:bold;font-size:14px;margin-bottom:4px;">Backup</div>
    <p style="font-size:12px;color:#555;margin-bottom:10px;line-height:1.4;">Saved inspections live in Safari on this device. Export a backup file now and then (save it to Files or iCloud Drive) so nothing is lost if Safari data is cleared.</p>
    <div style="display:flex;gap:10px;flex-wrap:wrap;">
      <button class="btn-save" onclick="exportBackup()">Export backup</button>
      <label class="btn-save" style="display:inline-block;">Import backup
        <input type="file" accept=".json,application/json" style="display:none;" onchange="importBackup(this)">
      </label>
    </div>
  </div>
</div>

<!-- SCREEN 1B: ROOM PICKER -->
<div id="screen-roompicker" style="display:none;">
  <div style="background:#1a2744;color:white;padding:12px 14px;font-size:16px;font-weight:bold;" id="rpTitle"></div>
  <p style="padding:12px 14px 6px;font-size:13px;color:#555;">Select a room to edit, or add a new one.</p>
  <div id="roomPickerList" style="padding:0 14px;"></div>
  <div style="padding:12px 14px;">
    <button class="btn-cancel" onclick="showMain()">Back</button>
  </div>
</div>

<!-- SCREEN 2: CATEGORY -->
<div id="screen-category" style="display:none;">
  <div class="cat-header-box">
    <div class="cat-header-top">
      <div class="cat-title-row">
        <span class="cat-screen-title" id="catScreenTitle"></span>
      </div>
      <label class="na-checkbox-wrap">
        <input type="checkbox" id="catNACheck" onchange="toggleCatNA(this)">
        Not Applicable
      </label>
    </div>
    <div id="catAreaComment" class="area-comment-row"></div>
  </div>
  <div class="label-row">
    <label id="catLabelCaption">Label or short description (optional)</label>
    <div style="display:flex;align-items:center;gap:20px;flex-wrap:wrap;">
      <div id="catLabelWrap"><strong>Label</strong> <input class="label-input" type="text" id="catLabelInput" placeholder=""></div>
      <div id="catExtraFields"></div>
    </div>
  </div>
  <table class="cat-items-table" id="catItemsTable">
    <thead>
      <tr>
        <th colspan="2">Meets Requirements</th>
        <th>Comments</th>
      </tr>
    </thead>
    <tbody id="catItemsBody"></tbody>
  </table>
  <div class="cat-actions">
    <button class="btn-cancel" onclick="goBackFromCategory()">Back</button>
    <button class="btn-save" onclick="saveCategory()">Save</button>
  </div>
</div>

<!-- SCREEN 3: ITEM CONDITIONS -->
<div id="screen-item" style="display:none;">
  <div class="item-screen-header">
    <div id="itemScreenBreadcrumb" style="font-size:15px;font-weight:bold;color:#1a1a1a;"></div>
  </div>
  <table class="conditions-table">
    <thead>
      <tr>
        <th class="col-head-cond" colspan="2">Condition</th>
        <th class="col-head-comment">Comments</th>
      </tr>
    </thead>
    <tbody id="conditionsBody"></tbody>
  </table>
  <div class="item-actions">
    <button class="btn-cancel" onclick="showCategory()">Back</button>
    <button class="btn-next" onclick="saveItemAndReturn()">Next &gt;&gt;</button>
  </div>
</div>

<script>
// =======================================
// DATA
// =======================================
const categories = [
  {
    id: 'basement',
    name: 'Basement',
    itemStartIndex: 1,
    items: [
      {
        id: 'bsmt-stairs', name: 'Basement Stairs/Railings',
        conditions: [
          { code:'NA', text:'Not Applicable/Does Not Apply' },
          { code:'SC', text:'Staircase is not capable of supporting normal loads. Building permit needed to repair.' },
          { code:'B', text:'Riser height is greater than 8 in.' },
          { code:'B', text:'Tread depth is less than 9 in.' },
          { code:'B', text:'Uneven riser heights.' },
          { code:'B', text:'Stairway width is less than 30 in.' },
          { code:'B', text:'Stairway headroom is less than 6 ft 8 in.' },
          { code:'B', text:'Missing guardrail on open side of stairs.' },
          { code:'B', text:'Openings in guardrail over 9 in.' },
          { code:'RRE', text:'Missing handrail.' },
          { code:'C', text:'Loose handrail.' },
          { code:'B', text:'Handrail not gripable or not continuously gripable.' },
          { code:'B', text:'Handrail is mounted too close to the wall.' },
          { code:'B', text:'Handrail is not continous.' },
